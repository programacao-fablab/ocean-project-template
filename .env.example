# =============================================================================
#  MODELO DE VARIÁVEIS DE AMBIENTE — [NOME DO PROJETO]
#  1. Copie:  cp .env.example .env
#  2. Preencha o .env com valores reais. O .env NUNCA vai para o Git.
#  3. Criou variável nova? Adicione aqui (com valor fictício) E na tabela do README.
#
#  ⚠️ Prefixos VITE_ / NEXT_PUBLIC_ / EXPO_PUBLIC_ ficam VISÍVEIS no navegador.
#     Nunca use esses prefixos para segredos.
# =============================================================================

# --- Geral -------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info

# --- Frontend (públicas) -----------------------------------------------------
VITE_SUPABASE_URL=https://[ID_DO_PROJETO].supabase.co
VITE_SUPABASE_ANON_KEY=[CHAVE_ANON_PUBLICA]
VITE_API_BASE_URL=http://localhost:3000

# --- Backend (SECRETAS — somente no servidor) --------------------------------
API_PORT=3000
SUPABASE_SERVICE_ROLE_KEY=[CHAVE_SERVICE_ROLE_SECRETA]
DATABASE_URL=postgresql://[USUARIO]:[SENHA]@[HOST]:5432/[BANCO]

# --- MQTT (se usado) ---------------------------------------------------------
MQTT_BROKER_URL=mqtts://[HOST_DO_BROKER]:8883
MQTT_USERNAME=[USUARIO]
MQTT_PASSWORD=[SENHA]
MQTT_TOPIC_PREFIX=ocean/[projeto]
